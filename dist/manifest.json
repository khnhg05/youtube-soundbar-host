{
  "manifest_version": 3,
  "name": "MLA SOUNDBAR",
  "version": "1.1.0",
  "description": "Sản phẩm đến từ đội ngũ MLA",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "assets/js/content.js"
      ],
      "css": [
        "assets/css/style.css"
      ]
    }
  ]
}
